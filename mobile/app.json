{
  "expo": {
    "name": "나날",
    "slug": "nanal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "nanal",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "nanal.mengle.zen",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "나날은 사진 보관함을 읽거나 저장하지 않아요. 앱에 포함된 파일 기능 때문에 표시되는 항목이에요."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.nanal.mengle.zen"
        ]
      },
      "appleTeamId": "8V5VNMF9JM",
      "buildNumber": "7"
    },
    "android": {
      "package": "nanal.mengle.zen",
      "adaptiveIcon": {
        "backgroundColor": "#1E2F4D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/gowun-batang/400Regular/GowunBatang_400Regular.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-sans-kr/400Regular/IBMPlexSansKR_400Regular.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-sans-kr/500Medium/IBMPlexSansKR_500Medium.ttf",
            "./node_modules/@expo-google-fonts/nanum-pen-script/400Regular/NanumPenScript_400Regular.ttf",
            "./node_modules/@expo-google-fonts/gaegu/700Bold/Gaegu_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "말로 적을 수 있도록 마이크를 사용해요. 음성은 저장하지 않아요.",
          "speechRecognitionPermission": "말한 내용을 글로 받아 적기 위해 음성 인식을 사용해요. 기기에서 인식하지 못하면 Apple 서버로 보내져요. 음성은 저장하지 않아요."
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withSceneLifecycle",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1E2F4D"
        }
      ]
    ]
  }
}
